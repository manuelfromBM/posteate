SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Debe coincidir con tu Postgres local (no se usa docker-compose.yml actualmente)
DB_NAME=posteate_db
DB_USER=postgres
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Cloudinary (cuenta gratuita en cloudinary.com -> Dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Produccion (Render) ---
# En local no toques nada de esto, los defaults ya son los correctos para dev.
# Ver docs/technical/deployment.md para el detalle de cada una.
# DATABASE_URL=         # Render la inyecta solo al conectar la base de datos
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SESSION_COOKIE_SECURE=True
# SESSION_COOKIE_SAMESITE=None
# CSRF_COOKIE_SECURE=True
# CSRF_COOKIE_SAMESITE=None
